# GEMINI_API_KEY: Required for Google Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Local Ollama AI Engine (Server-side only — never exposed in frontend)
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_DEFAULT_MODEL="qwen2.5:3b"
COMPAT_AI_BASE_URL=""
COMPAT_AI_API_KEY=""
COMPAT_AI_MODEL=""

# Razorpay Subscriptions & Billing (INR)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Comma-separated administrator emails for Admin Dashboard RBAC bootstrap
ADMIN_EMAILS=""
